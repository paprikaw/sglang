+# SPDX-FileCopyrightText: Copyright contributors to the kvcached project
+# SPDX-License-Identifier: Apache-2.0
+"""Exercise the worker protocol without allocating CUDA memory."""
+
+import importlib.util
+import sys
+from pathlib import Path
+from types import ModuleType
+from unittest.mock import Mock
+
+import pytest
+
+
+@pytest.fixture
+def mapping(monkeypatch):
+    native = ModuleType("kvcached.vmm_ops")
+    native.kv_tensors_created = lambda group_id=0: True
+    native.map_to_kv_tensors = Mock(return_value=True)
+    native.unmap_from_kv_tensors = Mock(return_value=True)
+    monkeypatch.setitem(sys.modules, native.__name__, native)
+    path = Path(__file__).parents[1] / "kvcached/tp_ipc_util.py"
+    spec = importlib.util.spec_from_file_location("_worker_mapping_test", path)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    module._synchronize_worker_cuda = Mock()
+    module.register_worker_offset_filter(
+        lambda offsets, group: [offset for offset in offsets if offset < 512],
+        map_size=128,
+        layer_group_span=512,
+        num_layer_groups=3,
+    )
+    return module, native
+
+
+def test_allocator_maps_only_owned_groups_and_migration_bypasses_filter(mapping):
+    mod, native = mapping
+    assert mod._apply_worker_mapping_command("map_to_kv_tensors", [0, 128, 512])
+    assert mod.snapshot_worker_mapped_offsets() == (0, 128)
+    mod._synchronize_worker_cuda.assert_not_called()
+    assert mod.map_worker_offsets_for_migration([512, 640])
+    assert mod.snapshot_worker_mapped_offsets() == (0, 128, 512, 640)
+    assert native.map_to_kv_tensors.call_count == 4
+    mod._synchronize_worker_cuda.assert_called_once()
+
+
+def test_duplicate_maps_preserve_live_data(mapping):
+    mod, native = mapping
+    assert mod.map_worker_offsets_for_migration([512, 512, 640])
+    native.map_to_kv_tensors.reset_mock()
+    mod._synchronize_worker_cuda.reset_mock()
+    assert mod.map_worker_offsets_for_migration([640, 512])
+    native.map_to_kv_tensors.assert_not_called()
+    mod._synchronize_worker_cuda.assert_not_called()
+
+
+def test_map_failure_records_exact_progress_and_retry_skips_live_pages(mapping):
+    mod, native = mapping
+    native.map_to_kv_tensors.side_effect = [True, False, True]
+    assert not mod.map_worker_offsets_for_migration([512, 640])
+    assert mod.snapshot_worker_mapped_offsets() == (512,)
+    mod._synchronize_worker_cuda.assert_called_once()
+    assert mod.map_worker_offsets_for_migration([512, 640])
+    assert [call.args[0] for call in native.map_to_kv_tensors.call_args_list] == [
+        [512],
+        [640],
+        [640],
+    ]
+
+
+def test_map_exception_keeps_successful_prefix_for_abort(mapping):
+    mod, native = mapping
+    native.map_to_kv_tensors.side_effect = [True, RuntimeError("map failed")]
+    with pytest.raises(RuntimeError, match="map failed"):
+        mod.map_worker_offsets_for_migration([512, 640])
+    assert mod.snapshot_worker_mapped_offsets() == (512,)
+    mod._synchronize_worker_cuda.assert_called_once()
+    assert mod.unmap_worker_offsets_for_layer_groups([1], 512)
+    assert mod.snapshot_worker_mapped_offsets() == ()
+
+
+def test_unmap_only_retired_groups_and_retry_after_partial_failure(mapping):
+    mod, native = mapping
+    mod.map_worker_offsets_for_migration([0, 512, 640])
+    native.unmap_from_kv_tensors.side_effect = [True, False, True]
+    assert not mod.unmap_worker_offsets_for_layer_groups([1], 512)
+    assert mod.snapshot_worker_mapped_offsets() == (0, 640)
+    assert mod.unmap_worker_offsets_for_layer_groups([1], 512)
+    assert mod.snapshot_worker_mapped_offsets() == (0,)
+    assert mod.unmap_worker_offsets_for_layer_groups([1], 512)
+    assert native.unmap_from_kv_tensors.call_count == 3
+
+
+def test_nested_pins_block_reclamation_until_final_release(mapping):
+    mod, native = mapping
+    mod.map_worker_offsets_for_migration([512, 640])
+    lease = mod.pin_worker_offsets([512, 640])
+    mod.pin_worker_offsets([640])
+    with pytest.raises(RuntimeError, match="pinned"):
+        mod.unmap_worker_offsets_for_layer_groups([1], 512)
+    native.unmap_from_kv_tensors.assert_not_called()
+    mod.unpin_worker_offsets(lease)
+    with pytest.raises(RuntimeError, match="pinned"):
+        mod.unmap_worker_offsets_for_layer_groups([1], 512)
+    assert mod.snapshot_worker_mapped_offsets() == (512, 640)
+    mod.unpin_worker_offsets([640])
+    assert mod.unmap_worker_offsets_for_layer_groups([1], 512)
+    assert mod.snapshot_worker_mapped_offsets() == ()
+
+
+def test_pin_underflow_and_unmapped_pin_leave_existing_pins_unchanged(mapping):
+    mod, _ = mapping
+    mod.map_worker_offsets_for_migration([512])
+    mod.pin_worker_offsets([512])
+    with pytest.raises(RuntimeError, match="unmapped"):
+        mod.pin_worker_offsets([512, 640])
+    with pytest.raises(RuntimeError, match="underflow"):
+        mod.unpin_worker_offsets([512, 640])
+    assert mod._worker_offset_pins[0][512] == 1
+
+
+def test_groups_have_independent_ledgers(mapping):
+    mod, _ = mapping
+    mod.map_worker_offsets_for_migration([0], group_id=0)
+    mod.map_worker_offsets_for_migration([0], group_id=2)
+    mod.unmap_worker_offsets_for_layer_groups([0], 512, group_id=0)
+    assert mod.snapshot_worker_mapped_offsets(0) == ()
+    assert mod.snapshot_worker_mapped_offsets(2) == (0,)
+
+
+def test_normal_free_unmaps_prepared_pages_outside_active_filter(mapping):
+    mod, native = mapping
+    mod.map_worker_offsets_for_migration([0, 512])
+    mod._synchronize_worker_cuda.reset_mock()
+    assert mod._apply_worker_mapping_command("unmap_from_kv_tensors", [0, 512, 1024])
+    assert mod.snapshot_worker_mapped_offsets() == ()
+    assert native.unmap_from_kv_tensors.call_count == 2
+    mod._synchronize_worker_cuda.assert_called_once()
+
+
+def test_nonelastic_worker_keeps_native_dispatch(mapping):
+    mod, native = mapping
+    assert mod._apply_worker_mapping_command("map_to_kv_tensors", [128], group_id=8)
+    native.map_to_kv_tensors.assert_called_once_with([128], group_id=8)
+    assert mod.snapshot_worker_mapped_offsets(8) == ()
+
+
+@pytest.mark.parametrize("offsets", [[-128], [1], [1536]])
+def test_bad_offsets_rejected_before_native_call(mapping, offsets):
+    mod, native = mapping
+    with pytest.raises(ValueError):
+        mod.map_worker_offsets_for_migration(offsets)
