+    manager.avail_pages = {0: object(), 2: object()}
+    manager.full_pages = {1: object()}
+    assert manager.snapshot_inuse_page_ids() == [0, 1, 2]
+
+
+class _CapturedCreateArgs(Exception):
+
+    def __init__(self, args, kwargs):
+        super().__init__("captured create_kv_tensors")
